{
  "name": "AetheriaProject",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$path": "src/ServerScriptServices"
    },
    "ServerStorage": {
      "$path": "src/ServerStorage",
      "Packages": {
        "$path": "ServerPackages"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client"
      }
    },
    "Workspace": {
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [8, 1, 8],
          "Position": [0, 1, 0],
          "Transparency": 1,
          "CanCollide": false
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2,
        "ClockTime": 10,
        "GlobalShadows": true,
        "Technology": "Future",
        "Ambient": [0.3, 0.3, 0.3],
        "OutdoorAmbient": [0.3, 0.3, 0.3]
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.5,
          "Decay": [0.92, 0.95, 1],
          "Glare": 0,
          "Haze": 1
        }
      }
    }
  }
}