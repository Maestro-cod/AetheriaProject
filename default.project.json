{
  "name": "AetheriaProject",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$path": "src/ServerScriptServices"
    },
    "ServerStorage": {
      "$path": "src/ServerStorage"
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client"
      }
    },
    "Workspace": {
      "MallFloor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [512, 1, 512],
          "Position": [0, 0, 0],
          "Color": [0.95, 0.95, 0.95],
          "Material": "Marble",
          "Locked": true
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [8, 1, 8],
          "Position": [0, 1, 0],
          "Transparency": 1,
          "CanCollide": false
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2,
        "GlobalShadows": true,
        "Technology": "Voxel"
      }
    }
  }
}
